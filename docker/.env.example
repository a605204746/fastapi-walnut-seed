# ==================================================================
# Docker 编排变量插值模板：复制为 docker/.env 后按需修改
# docker compose 会自动读取编排文件同目录的 .env 做变量插值
# （注意：这是 compose 的插值文件，与后端 walnut-backend-python/env/ 无关）。
# JWT_SECRET_KEY 为强制项（编排内以 ${VAR:?...} 引用，未设置/留空则启动直接失败）；
# 其余变量未设置时由编排内 ${VAR:-默认值} 兜底，开箱即用。
# ==================================================================

# MySQL root 密码（mysql 服务与两个后端的数据库密码共用，一处改处处生效）
DB_PASSWORD=walnut123

# Python 后端业务库名（中间件首次初始化建库 + Python backend 连接共用）。
# Java 后端固定使用 walnut_seed_java（JDBC URL 自动建库），不受此变量影响
DB_NAME=walnut_seed_python

# 后端服务端口（backend 监听 + nginx upstream 共用；前端容器对外仍是 8010）
BACKEND_PORT=8011

# JWT 签名密钥：必填！两套全栈编排均以 ${JWT_SECRET_KEY:?...} 强制引用
# （Python 编排注入 SECRET_KEY，Java 编排注入 SA_TOKEN_JWT_SECRET_KEY），
# 未设置或留空时 docker compose up 会直接报错退出，不会静默使用任何默认密钥。
# 此处刻意留空：示例值一旦被原样复制上生产即为公开密钥（本仓库公开可见），
# 复制本模板后务必先生成再粘贴（要求 ≥32 字节）：
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=aad4577efe3d3c43981c8b9b4e9ec5225926b54b5e332c0d9df3fbc8776b2224

# ------------------------------------------------------------------
# 接口加解密 RSA 密钥对（仅 Go 编排读取：docker-compose.go.yml / .go.demo.yml）
# ------------------------------------------------------------------
# 两项默认留空，后端会自动停用加解密并降级为明文（启动日志有告警）。
# 编排自带的 nginx 前端是生产构建（VITE_GLOB_ENABLE_ENCRYPT=false），留空即可正常跑。
#
# 什么时候必须填：把**开发模式**前端指向容器后端时。两个前端工程的
# .env.development 均为 VITE_GLOB_ENABLE_ENCRYPT=true，会发 AES 密文 + encrypt-key 头；
# 后端未配密钥则不解密，直接把密文当 JSON 解析，返回「请求数据格式错误（JSON 解析失败）」。
# 典型场景：walnut-frontend-react 的像素回归需要 8010/8020 两个 dev server 共用
# 同一个容器后端（两者 vite.config 均代理 /api → http://localhost:8011）。
#
# 配对规则（与 walnut-backend-go/env/.env.example 逐字一致）：
#   API_DECRYPT_PRIVATE_KEY 解前端请求 —— 对应前端 VITE_GLOB_RSA_PUBLIC_KEY
#   API_DECRYPT_PUBLIC_KEY  加后端响应 —— 对应前端 VITE_GLOB_RSA_PRIVATE_KEY
#
# 此处刻意留空（同 JWT_SECRET_KEY 的理由：模板值被原样复制上生产即为公开密钥）。
# 开发联调直接把 walnut-backend-go/env/.env.dev 里的同名两项粘过来即可：
#   该对密钥与 Python 端 .env.dev 完全相同，且已与两个前端的 dev 环境三方配对，
#   可用 scripts/verify_key_pairing.py 一键校验。
#   生产必须整体重新生成，勿沿用开发密钥。
#
# 填了密钥会不会影响生产前端？不会。请求解密按 encrypt-key 头 opt-in（不带头的
# 明文请求直接放行）；响应加密需路由显式挂 EncryptResponse()，当前无任何路由挂载。
API_DECRYPT_ENABLED=true
API_DECRYPT_HEADER_FLAG=encrypt-key
API_DECRYPT_PUBLIC_KEY=
API_DECRYPT_PRIVATE_KEY=

# 图形验证码开关（仅 Go 编排读取）。默认 true = 后端内置默认值，行为不变。
# 跑自动化测试（walnut-frontend-react/e2e/visual 的像素回归、e2e 冒烟）时置 false：
# 否则登录页会多出验证码输入框，无法非交互式填写，会话建立不了。
# 置 false 后 /auth/code 返回 captchaEnabled=false，前端按契约不渲染该输入框。
CAPTCHA_ENABLE=true

# SeaweedFS S3 凭据（当前镜像版本 S3 网关不校验身份，保留以备升级后启用）
OSS_ACCESS_KEY=walnut
OSS_SECRET_KEY=walnut123
