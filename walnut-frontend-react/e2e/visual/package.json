{
  "name": "@walnut-seed/e2e-visual",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vue ↔ React 双端像素回归门禁（方案 C 全自绘复刻的客观验收手段）",
  "scripts": {
    "test": "playwright test",
    "test:vue": "playwright test --grep @capture-vue",
    "capture:golden": "cross-env VISUAL_CAPTURE=vue playwright test specs/capture.spec.ts",
    "capture:react": "cross-env VISUAL_CAPTURE=react playwright test specs/capture.spec.ts",
    "compare": "playwright test specs/compare.spec.ts",
    "report": "playwright show-report report",
    "install:browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/pngjs": "catalog:",
    "@walnut-seed/web-react": "workspace:*",
    "cross-env": "catalog:",
    "pixelmatch": "catalog:",
    "pngjs": "catalog:",
    "typescript": "catalog:"
  }
}
