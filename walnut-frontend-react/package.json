{
  "name": "walnut-seed-admin-react",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "walnut-seed",
    "react",
    "react19",
    "admin",
    "starter"
  ],
  "license": "MIT",
  "author": {
    "name": "deepin_sir"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "tsc --noEmit && vite build --mode production",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/visual",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src build e2e --quiet",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build",
    "e2e": "playwright test --config e2e/visual/playwright.config.ts",
    "e2e:install": "playwright install chromium",
    "e2e:capture:golden": "cross-env VISUAL_CAPTURE=vue playwright test --config e2e/visual/playwright.config.ts specs/capture.spec.ts",
    "e2e:capture:react": "cross-env VISUAL_CAPTURE=react playwright test --config e2e/visual/playwright.config.ts specs/capture.spec.ts",
    "e2e:compare": "playwright test --config e2e/visual/playwright.config.ts specs/compare.spec.ts",
    "e2e:report": "playwright show-report e2e/visual/report"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ctrl/tinycolor": "^4.2.0",
    "@iconify/react": "^5.2.1",
    "@tanstack/react-store": "^0.11.0",
