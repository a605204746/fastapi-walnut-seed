{
  "name": "walnut-seed-admin-react",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "walnut-seed",
    "monorepo",
    "react",
    "react19",
    "admin",
    "starter"
  ],
  "license": "MIT",
  "author": {
    "name": "deepin_sir"
  },
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm install",
    "postinstall": "pnpm -r run --if-present stub",
    "dev": "pnpm -F @walnut-seed/web-react run dev",
    "build": "pnpm -F @walnut-seed/web-react run build",
    "preview": "pnpm -F @walnut-seed/web-react run preview",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint apps packages internal e2e --quiet",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "catalog:",
    "@vben/tsconfig": "workspace:*",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "^9.39.4",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "happy-dom": "catalog:",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "catalog:",
    "typescript-eslint": "^8.73.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.2.2"
}
