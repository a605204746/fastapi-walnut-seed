    "@tiptap/starter-kit": "^3.34.0",
    "antd": "^6.7.0",
    "axios": "^1.16.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.20",
    "defu": "^6.1.7",
    "echarts": "^6.1.0",
    "es-toolkit": "^1.45.1",
    "file-type": "^19.5.0",
    "i18next": "^26.0.0",
    "jsencrypt": "^3.5.4",
