# WalnutSeed Go 后端环境配置模板
#
# 复制为 .env.dev（本地开发）后按需修改；Docker 部署不使用本目录，
# 容器内配置全部来自 docker/docker-compose.go.yml 的环境变量（见 .dockerignore）。
#
# 加载优先级（高 → 低）：
#   真实环境变量 > env/.env.{ENVIRONMENT} > internal/config/config.go 的代码默认值
#
# 本文件只列出**常改项**。全部约 105 个配置项及其默认值见 internal/config/config.go，
# 它是配置的唯一事实源（对应 Python 端 app/config/setting.py）。

# ==================== 环境与服务 ====================
# dev / prod。prod 会启用更严格的密钥校验与 TrustedHost 等中间件
ENVIRONMENT=dev
SERVER_HOST=0.0.0.0
# 与 Python / Java 端相同，前端无需任何改动即可切换后端
SERVER_PORT=8011
DEBUG=true

# ==================== 日志 ====================
# DEBUG / INFO / WARNING / ERROR
LOGGER_LEVEL=DEBUG
# 留空则本地开发回退到 ../data/logs；生产恒为空（交给 stdout 采集）
LOG_DIR=
LOG_FILENAME=walnut-seed-go.log
LOG_MAX_SIZE_MB=50
LOG_MAX_BACKUPS=10
LOG_MAX_AGE_DAYS=30

# ==================== 安全 ====================
# JWT 签名密钥，**必须 ≥32 字节**。
# 为空 / 含 "change-me" / 过短时：dev 仅告警，prod 直接拒绝启动。
# 生成：openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
TOKEN_NAME=Authorization
TOKEN_PREFIX=Bearer
ACCESS_TOKEN_EXPIRE_SECONDS=2592000
TOKEN_SLIDING_EXPIRE=true
CLIENT_ID_HEADER=clientid

# 可信代理 IP/网段，逗号分隔。仅当请求直连地址在此列表中时才解析 X-Forwarded-For。
# ⚠️ 留空 = 不解析任何转发头。反向代理部署时必须配置，否则限流与审计日志按代理地址计
TRUSTED_PROXY_IPS=

# 登录失败锁定策略
PASSWORD_MAX_RETRY_COUNT=5
PASSWORD_LOCK_TIME=10

# ==================== 数据库 ====================
# 仅支持 mysql
DATABASE_TYPE=mysql
DATABASE_HOST=localhost
# docker-compose.middleware.yml 对外映射的是 3307（避开宿主机自装的 3306）
DATABASE_PORT=3307
DATABASE_USER=root
DATABASE_PASSWORD=
# ⚠️ 必须与另两端区分：Python 用 walnut_seed_python，Java 用 walnut_seed_java。
# 库不存在时由 databasex.EnsureDatabase 自动创建（Go 驱动无 createDatabaseIfNotExist）
DATABASE_NAME=walnut_seed_go
DATABASE_AUTO_MIGRATE=true
DATABASE_ECHO=false
POOL_SIZE=10
MAX_OVERFLOW=20
POOL_TIMEOUT=30
# ⚠️ 必须小于 MySQL 的 wait_timeout（默认 28800），否则池中会积累失效连接
POOL_RECYCLE=1800

# ==================== Redis ====================
REDIS_HOST=localhost
# docker-compose.middleware.yml 对外映射的是 6380
REDIS_PORT=6380
REDIS_DB_NAME=0
REDIS_USER=
# 中间件编排的 Redis 未设密码，留空即免 AUTH。
# ⚠️ 不要填空格或引号包裹的空串——go-redis 会据此发送 AUTH 导致连接失败
REDIS_PASSWORD=
# ⚠️ 三端共存的硬约束，必须与 walnut-seed-python / walnut-seed-java 区分，
# 否则共用同一 Redis 实例时登录态、验证码、限流计数会互相串键
REDIS_KEY_PREFIX=walnut-seed-go
REDIS_DEFAULT_CACHE_TTL=86400

# ==================== 接口传输加解密（RSA + AES）====================
# 算法固定为 AES/ECB/PKCS7 + RSA/PKCS1v15，与前端 jsencrypt/crypto-js 对齐。
# 两把密钥留空则启动时自动停用加解密（降级为明文）并告警，绝不带假密钥运行。
#
# 需要**两对**密钥，配对关系：
#   API_DECRYPT_PRIVATE_KEY 解前端请求 —— 对应前端 VITE_GLOB_RSA_PUBLIC_KEY
#   API_DECRYPT_PUBLIC_KEY  加后端响应 —— 对应前端 VITE_GLOB_RSA_PRIVATE_KEY
#
# 生成（P1 提供 genkey 子命令）：go run . genkey --bits 1024
# ⚠️ 1024 位是 jsencrypt 的兼容上限；已实测 Go 1.24/1.25 均可正常使用 1024 位 RSA
API_DECRYPT_ENABLED=true
API_DECRYPT_HEADER_FLAG=encrypt-key
API_DECRYPT_PUBLIC_KEY=
API_DECRYPT_PRIVATE_KEY=

# ==================== XSS ====================
XSS_ENABLED=true
# 富文本接口需排除，否则正文里的 HTML 会被转义破坏内容
XSS_EXCLUDE_URLS=/system/notice

# ==================== 对象存储 ====================
# s3（任意 S3 兼容，默认 SeaweedFS）| aliyun
OSS_TYPE=s3
OSS_S3_ENDPOINT=localhost:8333
OSS_S3_ACCESS_KEY=walnut
OSS_S3_SECRET_KEY=walnut123
OSS_S3_BUCKET_NAME=walnut-seed
OSS_S3_SECURE=false
# 上传返回的中性路径前缀，经 GET /upload/{key} 由后端流式回源
OSS_S3_URL_PREFIX=/upload

# ==================== 推送 ====================
SSE_ENABLED=true
SSE_PATH=/resource/sse
# 默认关闭，但路径始终注册（未启用时连接仅本地回显）
WEBSOCKET_ENABLED=false
WEBSOCKET_PATH=/resource/websocket

# ==================== 雪花 ID ====================
# 0-1023。⚠️ 多副本部署必须显式配置且各实例互不相同，否则会产生重复 ID。
# 留空时回退为「本机 IP + 进程号」派生并告警（与 Python 端行为一致）
SNOWFLAKE_WORKER_ID=
