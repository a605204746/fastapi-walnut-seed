# 本地开发环境配置。只放与代码默认值不同的差异项，其余走 config.go 的默认值。
# 默认指向 docker-compose.middleware.yml 起的中间件（MySQL 3307 / Redis 6380 / SeaweedFS 8333）。

# ---- 环境与服务 ----
ENVIRONMENT=dev
SERVER_HOST=0.0.0.0
SERVER_PORT=8011
DEBUG=true

# ---- 日志 ----
LOGGER_LEVEL=DEBUG
# 留空则回退到 ../data/logs（与 Python 端一致：本地启动写仓库根 data/logs/）
LOG_DIR=
LOG_FILENAME=walnut-seed-go.log

# ---- 安全 ----
# ⚠️ 开发占位值，含 change-me，prod 环境会直接拒绝启动
SECRET_KEY=walnut-seed-change-me-32-bytes-min-jwt-secret-0123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=2592000
# 可信代理为空 → 不解析任何 X-Forwarded-For。
# 反向代理部署时必须填入代理的实际来源 IP/网段，否则限流与审计日志按直连地址计
TRUSTED_PROXY_IPS=

# ---- 数据库（Go 驱动无 createDatabaseIfNotExist，库由 EnsureDatabase 自动引导创建）----
DATABASE_TYPE=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3307
DATABASE_USER=root
DATABASE_PASSWORD=walnut123
DATABASE_NAME=walnut_seed_go
DATABASE_AUTO_MIGRATE=true
DATABASE_ECHO=false
POOL_SIZE=10
MAX_OVERFLOW=20
POOL_RECYCLE=1800

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB_NAME=0
REDIS_PASSWORD=
# ⚠️ 必须与另两端区分（walnut-seed-python / walnut-seed-java），否则串键
REDIS_KEY_PREFIX=walnut-seed-go

# ---- 接口加解密（RSA + AES）----
# 下面这对是**仅开发用**的 1024 位密钥，与 Python 端 env/.env.dev 同源，开箱可联调。
# 配对关系：
#   API_DECRYPT_PRIVATE_KEY 解前端请求 —— 对应前端 VITE_GLOB_RSA_PUBLIC_KEY
#   API_DECRYPT_PUBLIC_KEY  加后端响应 —— 对应前端 VITE_GLOB_RSA_PRIVATE_KEY
# 生产环境必须重新生成，命中 RuoYi 出厂密钥黑名单会被拒绝启动。
API_DECRYPT_ENABLED=true
API_DECRYPT_HEADER_FLAG=encrypt-key
API_DECRYPT_PUBLIC_KEY=MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQCzWeB2rv0CLeABVtm9K7Ak/uOCSzeSeVYNLzaIDM5Nb84NQ22fYjSFLDnQVZCfBGFKAF5Qhy/yIziDKfewdA48+MzHm/ln8gCRiPane78G8ja4wDTx1atmkGUTgrInvUasjKFKOA2DK/ejqg4bYPiGKdarHpNoaDFd7NntkgmyiwIDAQAB
API_DECRYPT_PRIVATE_

# ---- XSS ----
XSS_ENABLED=true
XSS_EXCLUDE_URLS=/system/notice

# ---- 对象存储（SeaweedFS，S3 兼容）----
OSS_TYPE=s3
OSS_S3_ENDPOINT=localhost:8333
OSS_S3_ACCESS_KEY=walnut
OSS_S3_SECRET_KEY=walnut123
OSS_S3_BUCKET_NAME=walnut-seed
OSS_S3_SECURE=false
OSS_S3_URL_PREFIX=/upload

# ---- 推送 ----
SSE_ENABLED=true
WEBSOCKET_ENABLED=false
